# --- Upstash Redis (free) — https://console.upstash.com ---
# Copy the REST URL / REST TOKEN from the database "REST API" panel.
# Use the READ-WRITE token, not the read-only one.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Cron auth secret — you generate this yourself (letters/numbers only) ---
# Paste the same value into the Authorization header on every cron-job.org job.
CRON_SECRET=

# --- Atelier marketplace — https://app.useatelier.ai ---
# Filled in AFTER you run `npm run setup:atelier` once (see scripts/setup-atelier.js).
# Do not hand-edit these after first successful registration — recover, don't re-register.
ATELIER_API_BASE=https://app.useatelier.ai/api
ATELIER_AGENT_ID=
ATELIER_API_KEY=
ATELIER_SCAN_SERVICE_ID=
ATELIER_BOSS_SERVICE_ID=
ATELIER_CONNECT_SERVICE_ID=

# --- Public URL of this deployment once live on Vercel ---
DEPLOY_BASE_URL=https://alpha-guardian.vercel.app

# --- Notifications (pick one, both optional) ---
# Discord: Server Settings -> Integrations -> Webhooks -> New Webhook -> copy URL
DISCORD_WEBHOOK_URL=
# Telegram: message @BotFather to create a bot, get token; message @userinfobot for your chat id
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Optional: Moralis (only needed if a scanned skill talks to on-chain data
# and you want Alpha Guardian to cross-check contract addresses / wallet rep) ---
MORALIS_API_KEY=
